+.planner-requirements{grid-template-columns:84px minmax(0,1fr);padding:8px;border-radius:5px;background:#f7f8fa;border-left:2px solid var(--line2)}
+.planner-progress span,.planner-next span,.planner-requirements span{font-size:11px;color:var(--dim);padding-top:2px}
+.planner-progress p,.planner-requirements p{color:var(--ink);overflow-wrap:anywhere}
+.planner-requirements p{white-space:pre-wrap;margin:0}
 .planner-next{padding:8px;border-radius:5px;background:rgba(37,182,162,.07);border-left:2px solid var(--trk-edit)}
 .planner-next p{color:var(--ink);overflow-wrap:anywhere}
 .planner-original{margin-top:5px;font-family:var(--mono);font-size:12px;color:#2f5ec4}
